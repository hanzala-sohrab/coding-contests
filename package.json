{
  "name": "coding-contest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx --env-file=.env scripts/migrate.mts",
    "problems:sync": "tsx --env-file=.env scripts/sync-problems.mts",
    "setup": "npm run db:up && npm run db:migrate && npm run problems:sync",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "tsx --env-file=.env tests/e2e.mts"
  },
  "dependencies": {
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
